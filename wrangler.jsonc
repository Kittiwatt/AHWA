{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahwa",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Front statique (accueil, bibliothèque, page de table) servi par le même Worker.
  // Les requêtes qui ne correspondent à aucun fichier tombent dans le Worker (routes /r/<code>, /api, /rooms).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },

  // Une room = un Durable Object (stockage SQLite, obligatoire sur le plan gratuit).
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // v2/v3 (2026-09-03) : remise à zéro de toutes les tables de test — supprimer la classe efface
  // tous ses objets et leur stockage, puis la classe est recréée vide.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "deleted_classes": ["Room"] },
    { "tag": "v3", "new_sqlite_classes": ["Room"] }
  ],

  "observability": { "enabled": true }
}
