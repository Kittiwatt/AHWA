 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée (ou importe son deck sur son board joueur)."
  },
  {
   "when": "setup",
   "text": "Départ au choix : chaque enquêteur commence à l'un des deux Factory Floors. Cliquez votre lieu de départ pour le révéler (indices posés automatiquement) et glissez-y votre pion — ils sont posés à l'Ouest par défaut."
  },
  {
   "when": "setup",
   "text": "Jetons sang : mêmes règles qu'au scénario I — au plus 3 scellés par enquêteur, 12 en tout entre sac et enquêteurs. Menu du sac → « Sceller / Libérer », ou le chip « Sang scellé » du siège (+ scelle, − libère) ; « Ajuster… » pour les effets qui en ajoutent ou en retirent. La référence sur la carte de scénario montre l'effet des jetons selon votre difficulté."
  },
  {
   "when": "setup",
   "text": "Grottes de côté, face cachée : leurs dos (« Descending Tunnel », trois « Side Chamber » identiques) cachent ce qu'elles sont vraiment. Quand une carte les met en jeu, glissez-les depuis la zone de côté vers la rangée du bas du tapis, sans les retourner : elles entrent non révélées (clic pour révéler, indices posés automatiquement)."
  },
  {
   "when": "setup",
   "text": "Notes du journal de campagne (papier, l'app ne le tient pas) : « the investigators stole the manager's keys » conditionne l'entrée du Manager's Office ; « a sheet of arcane symbols » et « forged permits » pourront se noter en cours de partie quand les cartes l'indiquent."
  },
  {
   "when": "mythos",
   "text": "Doom sur l'agenda, puis chaque enquêteur pioche 1 carte rencontre (menu de la pioche)."
  },
  {
   "when": "enemy",
   "text": "Ennemis chasseurs : déplacez-les à la main. Relisez les capacités des ennemis prêts en fin de phase."
  },
  {
   "when": "act:2",
   "text": "Verso de l'acte 1 (panneau Histoire) : s'il met des grottes en jeu, glissez-les depuis la zone de côté sans les retourner — clic pour révéler quand un enquêteur y entre."
  },
  {
   "when": "act:3",
   "text": "Verso de l'acte 2 (panneau Histoire) : suivez-le pas à pas ; les cartes de côté qu'il nomme se glissent en jeu depuis la zone de côté."
  },
  {
   "when": "agenda:2",
   "text": "Verso de l'agenda 1 (panneau Histoire) : appliquez-le à la main — s'il faut toucher au sac, passez par menu du sac → Ajuster."
  }
