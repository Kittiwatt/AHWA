 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée."
  },
  {
   "when": "setup",
   "text": "Le Cosmos (guide) : les nouveaux lieux viennent de la pile « Cosmos ». Quand l'acte le permet, menu de la pile → « Regarder les X premières » : choisissez-en un, glissez-le sur le tapis à la position que dicte son instruction « Cosmos – » (au-dessus, à droite… de votre lieu), cliquez-le pour le révéler et déplacez votre pion ; puis « Mélanger » la pile pour y remettre les autres. Un lieu ne peut pas entrer à une position déjà occupée par un lieu ; si l'instruction est impossible, il retourne dans le Cosmos (glisser sur la pile, puis « Mélanger »). Ces instructions ne valent qu'au moment du tirage."
  },
  {
   "when": "setup",
   "text": "Espaces vides (guide) : les dos de carte joueur sur le tapis sont des espaces vides — pas des lieux, infranchissables sauf mention contraire, mais ils comptent pour les distances. Pour en poser un : menu d'un lieu → « Espace vide au-dessus / au-dessous / à gauche / à droite » ; quand un lieu prend la place d'un espace vide, retirez celui-ci (menu → Retirer) — hors application, la carte joueur retourne dans le deck de son propriétaire."
  },
  {
   "when": "setup",
   "text": "Azathoth est en jeu sans être à aucun lieu (posé à gauche du tapis). Les jetons ressource sur la carte de scénario sont les marques du journal. Court of the Great Old Ones, The Black Throne (côté Cosmos) et Piper of Azathoth attendent dans la zone de côté."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : le verso de l'acte 1 réorganise le tapis — reportez-vous au diagramme « Location Placement for Act 2 » du guide (p. 37) ; déplacez lieux, pions et espaces vides par glisser, retirez les espaces vides remplacés, révélez les lieux d'un clic."
  },
  {
   "when": "act:3",
   "text": "Acte 3 : les lieux de côté (côté Cosmos) entrent en jeu par glisser depuis la zone de côté, clic pour les révéler."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
