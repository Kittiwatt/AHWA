 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : retirez Elina Harper des decks pour ce scénario ; puis 5 ressources, main de départ, mulligan possible (ou import du deck sur son board joueur)."
  },
  {
   "when": "setup",
   "text": "Clés (guide) : noire, bleue, verte, violette et rouge de côté face visible — les cartes disent où elles se posent (glissez-les) ; blanche et jaune face cachée et mélangées (menu → « Poser ici une clé cachée au hasard » quand une carte le demande). Prendre le contrôle = glisser sur son siège. Dépenser une clé (guide « Spending Keys ») : elle va sur la carte de scénario — dans l'app, glissez-la dans la zone de côté ; seul celui qui la contrôle peut la dépenser."
  },
  {
   "when": "setup",
   "text": "Disposition (guide) : trois étages — rez-de-chaussée, premier, second — reliés comme les cartes l'indiquent. Les Tidal Tunnels (pile) et Lair of Dagon (de côté) entrent en jeu quand les actes le demandent : l'app le fait à l'avancement (voir le journal) ; pour un tunnel ponctuel, menu d'un lieu → ligne « Tidal Tunnels » ↓ ← → ⟳."
  },
  {
   "when": "setup",
   "text": "Inondation (guide) : menu du lieu → Inondation, panneau Marée ; l'acte 1 inonde tout d'un cran à son verso (appliqué par l'app). Y'ha-nthlei Statue et Dagon ont deux faces : menu → « Autre face »."
  },
  {
   "when": "setup",
   "text": "Bénédictions et malédictions (guide) : le sac en contient selon vos souvenirs (voir le journal) ; des versos d'agenda en ajoutent ou en retirent (appliqué par l'app) ; clic droit sur le sac → Ajuster pour le reste (10 au plus de chaque) ; révélé, un tel jeton retourne à la réserve : « ↺ Tout remettre » l'écarte tout seul."
  },
  {
   "when": "agenda:2",
   "text": "Agenda 2 : les jetons du verso de l'agenda 1 ont été ajustés (voir le journal). À la main, selon le journal : le suspect de côté entre en jeu là où la carte l'envoie (avec la clé bleue en version I, épuisé en version II), ou ce que la carte demande sinon."
  },
  {
   "when": "agenda:3",
   "text": "Agenda 3 : les jetons du verso de l'agenda 2 ont été ajustés (voir le journal). Version II : un enquêteur prend le contrôle de Thomas Dawson (glissez-le de la zone de côté sur son siège) et peut reprendre une clé dépensée."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : le verso de l'acte 1 a été appliqué — lieux retirés sauf Grand Entryway, Tidal Tunnels en jeu, tout inondé d'un cran, Syzygy et Tidal Alignment dans la pioche (voir le journal). À la main : retirez de la partie le suspect s'il est en jeu ; défaussez ce qui se trouvait sur les lieux retirés."
  },
  {
   "when": "act:3",
   "text": "Acte 3 : Lair of Dagon est entré en jeu totalement inondé et Dagon (recto) y est apparu (voir le journal). À la main : ajoutez au sac les malédictions que la carte indique selon l'agenda courant (clic droit sur le sac → Ajuster)."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
