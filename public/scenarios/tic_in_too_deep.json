 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée (ou importe son deck sur son board joueur)."
  },
  {
   "when": "setup",
   "text": "Barrières (guide) : un jeton ressource entre deux lieux = une barrière ; tant qu'il en reste une, les enquêteurs ne passent pas de l'un à l'autre, même connectés. On les retire par l'acte 1 ou certaines capacités de lieu : clic sur le jeton = −1, « + » au survol, menu d'un lieu « +1 barrière vers… ». Un chasseur suit le plus court chemin sans barrière (s'il n'en existe aucun, il les ignore) ; les autres déplacements d'ennemis les ignorent."
  },
  {
   "when": "setup",
   "text": "Clés (guide) : la clé noire est sur la cachette entourée ; les six autres sont de côté face cachée. Une carte peut en faire poser une au hasard (menu → « Poser ici une clé cachée au hasard »). Un enquêteur qui prend le contrôle d'une clé la retourne (glissez-la sur son siège)."
  },
  {
   "when": "setup",
   "text": "Inondation (guide) : trois lieux partiellement inondés au départ ; les agendas montent le niveau de certains lieux (l'app l'applique et l'écrit au journal) ; corrigez à la main les exceptions (menu du lieu → Inondation, panneau Marée)."
  },
  {
   "when": "setup",
   "text": "Bénédictions et malédictions (guide) : clic droit sur le sac → Ajuster (10 au plus de chaque) ; révélé, un tel jeton retourne à la réserve : « ↺ Tout remettre » l'écarte tout seul."
  },
  {
   "when": "agenda:2",
   "text": "Agenda 2 : inondation des lieux côtiers et mélange des cartes de côté avec la défausse appliqués (voir le journal)."
  },
  {
   "when": "agenda:3",
   "text": "Agenda 3 : inondation des lieux du centre-ville, Angry Mob à Innsmouth Square avec une clé cachée : appliqués (voir le journal)."
  },
  {
   "when": "agenda:4",
   "text": "Agenda 4 : tous les lieux montent d'un niveau d'inondation (appliqué). Ensuite, dans l'ordre des joueurs, chaque enquêteur pioche une carte rencontre (à faire à la main)."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour. Pensez aux barrières avant de déplacer un pion."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord (plus court chemin sans barrière), puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
