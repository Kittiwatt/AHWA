 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée (ou importe son deck sur son board joueur)."
  },
  {
   "when": "setup",
   "text": "Clés (guide) : blanche, noire, bleue, jaune et rouge de côté face visible — les cartes disent où elles se posent (glissez-les) ; violette et verte face cachée et mélangées (menu → « Poser ici une clé cachée au hasard » quand une carte le demande). Prendre le contrôle d'une clé = la glisser sur son siège (elle se retourne)."
  },
  {
   "when": "setup",
   "text": "Disposition (guide) : les lieux d'une même rangée sont connectés entre eux ; Lantern Room est au-dessus du Stairwell. Les Sunken Grotto entrent en jeu en colonne sous le Stairwell et les Tidal Tunnels complètent les rangées : l'app le fait à l'avancement des agendas et des actes (voir le journal) ; pour un tunnel ponctuel, menu d'un lieu → ligne « Tidal Tunnels » ↓ ← → ⟳. Captured! (colonne Agenda et acte) : « Autre face » la fait devenir le lieu Holding Cells — glissez-la sur le tapis."
  },
  {
   "when": "setup",
   "text": "Inondation (guide) : menu du lieu → Inondation, panneau Marée ; certains lieux imprimés ne peuvent pas être totalement inondés."
  },
  {
   "when": "setup",
   "text": "Bénédictions et malédictions (guide) : clic droit sur le sac → Ajuster (10 au plus de chaque) ; révélé, un tel jeton retourne à la réserve : « ↺ Tout remettre » l'écarte tout seul."
  },
  {
   "when": "agenda:2",
   "text": "Agenda 2 : les gestes mécaniques du verso ont été appliqués (voir le journal). À la main : Oceiros Marsh entre en jeu là où la carte l'envoie (glissez-le de la zone de côté), la clé bleue (de côté) se pose sur lui, et ce que la carte retire aux enquêteurs."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : les gestes mécaniques du verso ont été appliqués (voir le journal). À la main : Oceiros Marsh entre en jeu là où la carte l'envoie, épuisé (glissez-le de la zone de côté), la clé bleue (de côté) se pose sur lui ; l'agenda avance aussi (« Avancer l'agenda »)."
  },
  {
   "when": "agenda:3",
   "text": "Agenda 3 : la descente a été mise en place (Lower et Final Depths sous Upper Depths, rangées complétées par des tunnels, Taken Captive dans la pioche — voir le journal). À la main : les enquêteurs capturés (leurs clés sur Holding Cells : « Autre face » de Captured!, sur le tapis), Oceiros Marsh de côté s'il est en jeu ; puis « Avancer l'acte » directement à l'acte 3 sans résoudre le verso de l'acte 2."
  },
  {
   "when": "act:3",
   "text": "Acte 3 : la descente a été mise en place (voir le journal). À la main : Oceiros Marsh en zone de victoire s'il est en jeu ; puis « Avancer l'agenda » directement à l'agenda 3 sans résoudre le verso de l'agenda 2."
  },
  {
   "when": "agenda:4",
   "text": "Agenda 4 : Oceiros Marsh est apparu à Upper Depths et les lieux Falcon Point ont quitté la partie (voir le journal) ; déplacez à Upper Depths les pions et ennemis qui s'y trouvaient (le reste est défaussé) ; puis inondez les quatre lieux les plus bas qui le peuvent (menu → Inondation)."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
