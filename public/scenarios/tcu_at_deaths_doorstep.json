 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée."
  },
  {
   "when": "setup",
   "text": "Lieux qui se remplacent (guide) : quand une carte demande d'échanger un lieu contre sa version spectrale, menu du lieu → « Remplacer par sa version spectrale » (ou « Tous les lieux → version jumelle »). Jetons, pions et cartes restent en place ; l'ancien lieu part de côté ; un lieu occupé par un enquêteur est révélé avec ses indices."
  },
  {
   "when": "setup",
   "text": "Zone de côté : Josef Meiger (menu → « Lire le côté histoire » seulement quand une carte l'indique), les sept lieux Spectral, les sets Realm of Death et The Watcher. Un ennemi à mettre de côté : menu → « Mettre de côté » ; il revient sur le tapis par glisser. Une carte de côté rejoint la pioche par « Mélanger dans la pioche »."
  },
  {
   "when": "agenda:2",
   "text": "Agenda 2 : pour retirer d'un coup tous les indices des lieux, menu d'un lieu → « Retirer tous les indices des lieux ». L'interlude se lit dans le guide (lien « Guide » en haut de la table)."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : les remplacements de lieux se font par le menu d'un lieu (« Tous les lieux → version jumelle » : jetons conservés, lieux occupés révélés) ; déplacez pions et ennemis par glisser ; les cartes mises de côté rejoignent la pioche par leur menu « Mélanger dans la pioche », la défausse par « Remélanger dans la pioche » (clic droit sur la défausse)."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
