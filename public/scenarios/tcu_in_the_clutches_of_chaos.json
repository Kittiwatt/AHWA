 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée."
  },
  {
   "when": "setup",
   "text": "Brèches et incursions (guide) : le doom n'avance pas comme d'habitude ; des brèches — jetons ressource — se posent sur les lieux (menu du lieu → Marqueur ± pour en ajouter ou en retirer). Quand une brèche devrait se poser sur un lieu qui en a déjà trois, une incursion s'y produit : on retire ses brèches, on y pose 1 doom, puis 1 brèche sur chaque lieu relié — cela peut s'enchaîner ; un lieu déjà touché par une incursion n'en reçoit plus des autres pendant le reste de la manche. Les chemins dessinés entre lieux aident à voir les lieux reliés."
  },
  {
   "when": "setup",
   "text": "Choisir un lieu au hasard (guide) : menu de la pile « Lieux au hasard » → « Tirer 1, 2 ou 3 au hasard (sans sortir) » ; le résultat s'affiche pour tout le monde. Piper of Azathoth attend dans la zone de côté."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : le verso de l'acte 1 est un ennemi — clic droit sur l'acte → « Retourner (lire le verso) », puis glissez-le sur le lieu indiqué avant d'avancer ; l'acte suivant sort et l'ennemi reste en jeu."
  },
  {
   "when": "mythos",
   "text": "Phase du Mythe de ce scénario : pas de doom automatique sur l'agenda — à la place, l'agenda demande des brèches sur des lieux tirés au hasard (menu de la pile « Lieux au hasard » → « Tirer n au hasard », puis Marqueur + sur chaque lieu nommé). Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
