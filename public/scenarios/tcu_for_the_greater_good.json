 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée."
  },
  {
   "when": "setup",
   "text": "Clés (guide) : les quatre jetons de côté sont des clés, pas des jetons du chaos. Une carte les fait entrer en jeu sur un ennemi, un lieu ou un soutien ; un enquêteur qui en prend le contrôle la glisse sur son siège ; un enquêteur éliminé laisse ses clés sur son lieu ; on peut donner ses clés à un enquêteur au même lieu. Un lieu sans indice qui porte une clé : la prendre est une action."
  },
  {
   "when": "setup",
   "text": "Zone de côté : Library, Vault, Inner Sanctum et les deux Sanctum Doorway (entrent en jeu par glisser, clic pour révéler), Puzzle Box et August Lindquist (se donnent à un enquêteur par glisser sur son siège), Summoned Beast, Nathan Wick — deux faces d'ennemi, choisissez la bonne par le menu « Autre face » avant de le poser."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : Nathan Wick entre en jeu depuis la zone de côté (menu « Autre face » pour la face demandée), Puzzle Box se pose près de lui ; un lieu de côté qui entre en jeu se glisse sur le tapis puis se révèle d'un clic."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
