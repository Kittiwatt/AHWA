 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée."
  },
  {
   "when": "setup",
   "text": "Les trois Decrepit Door cachent trois pièces différentes : un clic les révèle (indices posés). La pile « Unknown Places » (à côté de la pioche) sert quand une carte demande d'en prendre la première : cliquez pour tirer, glissez-la sur le tapis (elle entre non révélée), cliquez-la pour la révéler."
  },
  {
   "when": "setup",
   "text": "Zone de côté : Nahab, The Black Book, Strange Geometry ×2, Ghostly Presence ×2 (face visible), Site of the Sacrifice et Keziah's Room (non révélés). Une carte de côté rejoint la pioche par son menu « Mélanger dans la pioche » ; un lieu de côté entre en jeu par glisser ; The Black Book se donne à un enquêteur par glisser sur son siège."
  },
  {
   "when": "act:2",
   "text": "Acte 2 : pour ce que demande le verso de l'acte 1 — menu de Walter Gilman's Room → « Remplacer par Keziah's Room (mise de côté) » (jetons et cartes conservés), puis « Retirer de la partie tous les autres lieux » ; les cartes de côté à mélanger passent par « Mélanger dans la pioche » ; The Black Book se glisse sur le siège de son porteur."
  },
  {
   "when": "act:3",
   "text": "Acte 3 : Site of the Sacrifice entre en jeu par glisser depuis la zone de côté (clic pour le révéler et poser ses indices) ; les ennemis se déplacent par glisser, le doom par le menu ou le clic sur le compteur."
  },
  {
   "when": "agenda:2",
   "text": "Agenda 2 : une carte de côté entre en jeu par glisser ; « Mélanger dans la pioche » pour celles qui rejoignent la pioche ; « Chercher » (clic droit sur la pioche) pour y trouver une carte précise."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
