 "reminders": [
  {
   "when": "setup",
   "text": "Hors application : chaque joueur prend ses 5 ressources, pioche sa main de départ (mulligan possible) et garde son deck à portée."
  },
  {
   "when": "setup",
   "text": "Deux pioches de rencontre (guide) : la pioche standard sert par défaut ; un enquêteur qui se trouve dans un lieu au trait Spectral utilise la pioche spectrale à la place, pour tout (piocher, chercher, regarder…), sauf mention contraire. Chaque pioche a sa défausse : les cartes Spectral vont dans la défausse spectrale, les autres dans la défausse standard — les menus « Défausser » et « Mélanger dans… » choisissent la bonne pioche d'après le trait de la carte."
  },
  {
   "when": "setup",
   "text": "Les lieux ont deux faces révélées, normale et Spectral : quand une carte fait basculer un lieu, menu du lieu → « Autre face (Spectral) » ; basculer ne révèle pas le lieu (pas de nouveaux indices). La pile « Hérétiques » sert quand une carte demande un Heretic mis de côté : clic pour tirer, glisser sur le tapis ; son côté histoire se lit par le menu, seulement quand une carte l'indique. Spectral Web et le set The Watcher attendent dans la zone de côté."
  },
  {
   "when": "mythos",
   "text": "Un doom a été ajouté sur l'agenda. Chaque enquêteur pioche ensuite une carte rencontre et la résout — pioche spectrale s'il se trouve dans un lieu Spectral."
  },
  {
   "when": "investigation",
   "text": "Chaque enquêteur joue un tour complet (3 actions) dans l'ordre choisi par le groupe ; un joueur annonce qu'il prend son tour."
  },
  {
   "when": "enemy",
   "text": "Les ennemis chasseurs se déplacent d'abord, puis chaque ennemi engagé attaque son enquêteur."
  },
  {
   "when": "upkeep",
   "text": "Les cartes sont redressées et les actions remises à 3. Hors application : défaussez jusqu'à 8 cartes, piochez 1 carte et gagnez 1 ressource."
  }
 ],
